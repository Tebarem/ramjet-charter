<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-server compile check against the public Ramjet.Api package (nuget.org): the server loads src/ as a source plugin
       (deployed as plugins/charter/); this project only checks that it compiles against the published API. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ramjet.Api" Version="1.0.0-preview.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="obj/**;bin/**" />
    <None Remove="data/**" />
  </ItemGroup>
</Project>
