<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-server tests for src/: the store model, the importers, the core seam and the pure resolver are compiled in directly.
       Set RAMJET_HOME to the engine build output (the folder that holds dotnet/Mc.Scripting.Api.dll). No NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Charter.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../src/Model/**/*.cs" />
    <Compile Include="../../src/Import/**/*.cs" />
    <Compile Include="../../src/Core/ICharterCore.cs" />
    <Compile Include="../../src/Core/Resolver.cs" />
    <Compile Include="../../src/Core/StoreFile.cs" />
    <Reference Include="Mc.Scripting.Api">
      <HintPath>$(RAMJET_HOME)/dotnet/Mc.Scripting.Api.dll</HintPath>
    </Reference>
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- the core uses Ramjet API types (compile only: the package has no runtime asset) -->
    <PackageReference Include="Ramjet.Api" Version="1.0.0-preview.4" />
  </ItemGroup>
</Project>
